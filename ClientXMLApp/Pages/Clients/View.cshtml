@page
@using System.Globalization
@model ClientXMLApp.Pages.Clients.ViewModel
@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="sortBy" class="form-label">Sort by</label>
        <select id="sortBy" class="form-control" asp-for="SortBy">
            <option value="None">Default</option>
            <option value="Name">Name</option>
            <option value="BirthDate">Birth Date</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="sortOrder" class="form-label">Order</label>
        <select id="sortOrder" class="form-control" asp-for="SortAscending">
            <option value="true">Ascending</option>
            <option value="false">Descending</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="pageSize" class="form-label">Per page</label>
        <select id="pageSize" class="form-control" asp-for="PageSize">
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a class="btn btn-secondary"
           asp-page="/Clients/View"
           asp-page-handler="Export"
           asp-route-SortBy="@Model.SortBy"
           asp-route-SortAscending="@Model.SortAscending">Export to JSON</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Birth Date</th>
            <th>Addresses</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model.Clients.Items)
        {
            <tr>
                <td>@client.ID</td>
                <td>@client.Name</td>
                <td>@client.BirthDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                <td>
                    <ul class="mb-0">
                        @foreach (var address in client.Addresses)
                        {
                            <li>@address.AddressText (@address.Type)</li>
                        }
                    </ul>
                </td>
            </tr>
        }
        @if (Model.Clients.TotalCount == 0)
        {
            <tr>
                <td colspan="4">No clients yet. <a asp-page="/Clients/Import">Import an XML file</a> to get started.</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Clients.TotalCount > 0)
{
    <nav class="d-flex justify-content-between align-items-center">
        <span class="text-muted">
            Showing @Model.Clients.FirstItemOnPage&ndash;@Model.Clients.LastItemOnPage
            of @Model.Clients.TotalCount
        </span>
        <span>
            @if (Model.Clients.HasPreviousPage)
            {
                <a class="btn btn-outline-secondary btn-sm"
                   asp-page="/Clients/View"
                   asp-route-SortBy="@Model.SortBy"
                   asp-route-SortAscending="@Model.SortAscending"
                   asp-route-PageSize="@Model.Clients.PageSize"
                   asp-route-PageNumber="@(Model.Clients.PageNumber - 1)">Previous</a>
            }
            <span class="mx-2">Page @Model.Clients.PageNumber of @Model.Clients.TotalPages</span>
            @if (Model.Clients.HasNextPage)
            {
                <a class="btn btn-outline-secondary btn-sm"
                   asp-page="/Clients/View"
                   asp-route-SortBy="@Model.SortBy"
                   asp-route-SortAscending="@Model.SortAscending"
                   asp-route-PageSize="@Model.Clients.PageSize"
                   asp-route-PageNumber="@(Model.Clients.PageNumber + 1)">Next</a>
            }
        </span>
    </nav>
}
