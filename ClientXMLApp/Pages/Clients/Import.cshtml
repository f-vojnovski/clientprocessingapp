@page
@model ClientXMLApp.Pages.Clients.ImportModel
@{
    ViewData["Title"] = "Import Clients";
}

<h2>Import Clients</h2>

<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="xmlFile">Select XML File</label>
        <input type="file" id="xmlFile" name="xmlFile" class="form-control" accept=".xml" />
    </div>
    <button type="submit" class="btn btn-primary">Import</button>
</form>

@if (Model.ImportSucceeded)
{
    <div class="alert alert-success mt-3">
        Imported @Model.ImportedCount @(Model.ImportedCount == 1 ? "client" : "clients").
        <a asp-page="/Clients/View">View them</a>.
    </div>
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger mt-3">
        @Model.ErrorMessage
    </div>
}
